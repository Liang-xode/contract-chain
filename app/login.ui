     <property name="styleSheet">
      <string notr="true">QFrame#card {
    background-color: rgba(6, 16, 38, 205);
    border: 1px solid rgba(72, 198, 255, 110);
    border-radius: 18px;
}
QFrame#card QLabel {
    color: #C9E6FA;
    background: transparent;
}
QFrame#card QLabel#lbl_brand {
    color: #49D8FF;
    font-weight: bold;
    font-size: 11px;
}
QFrame#card QLabel#lbl_title {
    color: #FFFFFF;
    font-size: 22px;
    font-weight: bold;
}
QFrame#card QLabel#lbl_sub {
    color: #8FB6D2;
    font-size: 12px;
}
QFrame#card QLineEdit {
    background-color: rgba(255, 255, 255, 16);
    border: 1px solid rgba(105, 190, 240, 90);
    border-radius: 8px;
    padding: 7px 10px;
    color: #EAF7FF;
    selection-background-color: #1B78C8;
}
QFrame#card QLineEdit:focus {
    border: 1px solid #49D8FF;
    background-color: rgba(255, 255, 255, 28);
}
QFrame#card QPushButton#btn_login {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #21C8F6, stop:1 #3E7BFA);
    border: none;
    border-radius: 9px;
    color: #02121F;
    font-weight: bold;
    font-size: 14px;
}
QFrame#card QPushButton#btn_login:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #55DCFF, stop:1 #5E93FF);
}
QFrame#card QPushButton#btn_login:pressed {
    background-color: #1587C8;
}
QFrame#card QPushButton#btn_login:disabled {
    background-color: rgba(70, 110, 150, 120);
    color: rgba(255, 255, 255, 120);
}
QFrame#card QPushButton#btn_do_register {
    background-color: rgba(33, 200, 246, 40);
    border: 1px solid rgba(73, 216, 255, 120);
    border-radius: 9px;
    color: #BDF0FF;
    font-weight: bold;
}
QFrame#card QPushButton#btn_do_register:hover {
    background-color: rgba(33, 200, 246, 75);
}
QFrame#card QPushButton#btn_to_register, QFrame#card QPushButton#btn_back,
QFrame#card QPushButton#btn_quit {
    border: none;
    color: #7FDBFF;
    background: transparent;
}
QFrame#card QPushButton#btn_to_register:hover, QFrame#card QPushButton#btn_back:hover {
    color: #FFFFFF;
}
QFrame#card QPushButton#btn_quit {
    color: #7C93A8;
}</string>
