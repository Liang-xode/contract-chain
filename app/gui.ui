              <string>退出当前账号</string>
             </property>
             <property name="flat">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </item>
        </layout>
       </widget>
       <widget class="QWidget" name="tab_users">
        <attribute name="title">
         <string>④ 用户权限管理</string>
        </attribute>
        <layout class="QVBoxLayout" name="tab_users_layout">
         <item>
          <widget class="QLabel" name="lbl_users_hint">
           <property name="text">
            <string>仅超级管理员可见：可将普通用户设为管理员，或将管理员降为普通用户。超级管理员账号受保护，不可在此修改。</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QTableWidget" name="tbl_users">
           <property name="minimumSize">
            <size>
             <width>0</width>
             <height>120</height>
            </size>
           </property>
           <property name="alternatingRowColors">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="users_btn_row">
           <item>
            <widget class="QPushButton" name="btn_refresh_users">
             <property name="text">
              <string>刷新列表</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btn_make_admin">
             <property name="text">
              <string>设为管理员</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btn_make_user">
             <property name="text">
              <string>设为普通用户</string>
             </property>
            </widget>
           </item>
           <item>
            <spacer name="users_btn_spacer">
             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>40</width>
               <height>20</height>
              </size>
             </property>
            </spacer>
           </item>
          </layout>
         </item>
         <item>
          <widget class="QLabel" name="lbl_users_msg">
           <property name="text">
            <string/>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="users_spacer">
           <property name="orientation">
            <enum>Qt::Vertical</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>20</width>
             <height>40</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </widget>
      </widget>
      <widget class="QGroupBox" name="log_group">
       <property name="title">
        <string>实时日志</string>
       </property>
       <layout class="QVBoxLayout" name="log_layout">
        <item>
         <widget class="QPlainTextEdit" name="log_box">
          <property name="minimumSize">
           <size>
            <width>0</width>
            <height>60</height>
           </size>
          </property>
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="maximumBlockCount">
           <number>3000</number>
          </property>
          <property name="readOnly">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="log_btn_row">
          <item>
           <spacer name="log_spacer">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>40</width>
              <height>20</height>
             </size>
            </property>
           </spacer>
          </item>
          <item>
           <widget class="QPushButton" name="btn_clear_log">
            <property name="text">
             <string>清空日志</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
