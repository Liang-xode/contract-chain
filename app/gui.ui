       <string notr="true">QWidget#nav_bar {
    background-color: #101C2E;
    border-radius: 10px;
}
QPushButton#btn_nav_sign, QPushButton#btn_nav_verify,
QPushButton#btn_nav_center, QPushButton#btn_nav_users {
    background: transparent;
    color: #A9C4DA;
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
}
QPushButton#btn_nav_sign:hover, QPushButton#btn_nav_verify:hover,
QPushButton#btn_nav_center:hover, QPushButton#btn_nav_users:hover {
    color: #FFFFFF;
    background: rgba(73, 216, 255, 35);
}
QPushButton#btn_nav_sign:checked, QPushButton#btn_nav_verify:checked,
QPushButton#btn_nav_center:checked, QPushButton#btn_nav_users:checked {
    color: #FFFFFF;
    background: rgba(33, 200, 246, 60);
}
QLabel#lbl_nav_user {
    color: #7FDBFF;
    padding-right: 8px;
}</string>
